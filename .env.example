# Claves de IA y modelos
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_SMART_MODEL=gemini-3.8-flash

# Nombre del Asistente VTuber
ASSISTANT_NAME=Yize

# Idioma de reconocimiento de voz (es-AR, es-ES, es-MX, etc.)
STT_LANGUAGE=es-AR

# Modo de interacción por defecto al abrir Yize: 'texto' o 'voz'
INTERACTION_MODE=texto

# Servicios automáticos al iniciar Yize (1 = activado, 0 = desactivado)
OVERLAY_ENABLED=1
MOBILE_ENABLED=1
MOBILE_TUNNEL=0

# Motor de síntesis de voz: 'fish' (Voz personalizada Fish Audio), 'edge' (local gratuito), o 'rvc'
TTS_ENGINE=fish

# Voz de Yize en Fish Audio (Cherry)
FISH_AUDIO_VOICE_ID=47a44476780a4f33bba12e834ff1d461
FISH_AUDIO_API_KEY=tu_fish_audio_api_key_aqui

# Voz neuronal gratuita (Microsoft Edge-TTS)
EDGE_VOICE=es-MX-DaliaNeural

# ElevenLabs (opcional)
ELEVENLABS_API_KEY=tu_elevenlabs_api_key_aqui
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

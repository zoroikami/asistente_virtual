# Claves de IA y modelos
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_SMART_MODEL=gemini-3.8-flash

# Nombre del Asistente VTuber
ASSISTANT_NAME=Yize

# Idioma de reconocimiento de voz (es-AR, es-ES, es-MX, etc.)
STT_LANGUAGE=es-AR

# Motor de síntesis de voz: 'edge' (local gratuito con tono y ritmo ágil), 'rvc' (clonación local GPU), o 'fish'
TTS_ENGINE=edge

# Voz de Yize en Fish Audio (opcional)
FISH_AUDIO_VOICE_ID=74d956ea95a54ce5814084787b09d9d8
FISH_AUDIO_API_KEY=tu_fish_audio_api_key_aqui

# Voz neuronal gratuita (Microsoft Edge-TTS)
EDGE_VOICE=es-MX-DaliaNeural

# ElevenLabs (opcional)
ELEVENLABS_API_KEY=tu_elevenlabs_api_key_aqui
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
